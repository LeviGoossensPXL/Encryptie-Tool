@model RsaViewModel

<div class="container mt-4">

    <div class="alert alert-info">
        <strong>RSA Encryption:</strong>
        Gebruik de public key om de AES key te encrypten.
        Gebruik de private key om te decrypten.
    </div>

    <form enctype="multipart/form-data">

        <div class="row mx-0 text-field mb-3">
            <label asp-for="@Model.InputAesKey" class="form-label">
                Input AES Key
                <span data-bs-toggle="tooltip"
                      title="AES key die geëncrypt wordt met RSA">
                   
                </span>
            </label>

            <textarea asp-for="@Model.InputAesKey"
                      class="form-control"
                      id="inputAesKey"></textarea>

            <label class="input-group-text mt-2" title="Load key from file" style="cursor:pointer">
                <input type="file" id="inputAesKeyFile" style="display:none">
            </label>

            <button type="button"
                    class="btn btn-outline-secondary btn-sm mt-2"
                    onclick="copyText('inputAesKey')">
                Copy
            </button>
        </div>

        <div class="row mb-3">
            <div class="col">
                <label asp-for="@Model.RsaPublicKey" class="form-label">
                    Public Key
                </label>

                <div class="input-group">
                    <input asp-for="@Model.RsaPublicKey"
                           class="form-control"
                           type="text" />

                    <label class="input-group-text" title="Load key from file" style="cursor:pointer">
                        <input type="file" id="publicKeyFile" style="display:none">
                    </label>
                </div>
            </div>

            <div class="col">
                <label asp-for="@Model.RsaPrivateKey" class="form-label">
                    Private Key
                </label>

                <div class="alert alert-warning mt-2">
                   Never share your private key.
                </div>

                <div class="input-group">
                    <input asp-for="@Model.RsaPrivateKey"
                           class="form-control"
                           type="text" />

                    <label class="input-group-text" title="Load private key from file" style="cursor:pointer">
                       <input type="file" id="privateKeyFile" style="display:none">
                    </label>
                </div>
            </div>
        </div>

        <button type="submit"
                asp-action="Encryption"
                class="btn btn-primary my-3"
                onclick="showLoading()">
            Encrypt AES Key
        </button>

        <button type="submit"
                asp-action="Decryption"
                class="btn btn-secondary my-3"
                onclick="showLoading()">
            Decrypt AES Key
        </button>

        <button type="reset"
                class="btn btn-danger my-3">
            Clear All Data
        </button>

    </form>
</div>

<div class="row mx-0 text-field mt-4">
    <label asp-for="@Model.OutputAesKey" class="form-label">
        Output
    </label>

    <textarea asp-for="@Model.OutputAesKey"
              class="form-control"
              id="outputAesKey">
@Model.OutputAesKey</textarea>

    <div class="mt-2">
        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                onclick="copyText('outputAesKey')">
            Copy
        </button>

        <a asp-action="DownloadOutput"
           asp-route-content="@Model.OutputAesKey"
           class="btn btn-success btn-sm">
            Download File
        </a>
    </div>
</div>

<script>
    document.getElementById('publicKeyFile').addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => document.getElementById('RsaPublicKey').value = e.target.result.trim();
        reader.readAsText(file);
    });

    document.getElementById('privateKeyFile').addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => document.getElementById('RsaPrivateKey').value = e.target.result.trim();
        reader.readAsText(file);
    });

    document.getElementById('inputAesKeyFile').addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => document.getElementById('inputAesKey').value = e.target.result.trim();
        reader.readAsText(file);
    });

    function copyText(id) {
        const element = document.getElementById(id);
        navigator.clipboard.writeText(element.value);
    }

    function showLoading(){
        document.body.style.cursor = "wait";
    }
</script>