@model AesEncryptionViewModel
<div>
    <a asp-action="Decryption">Go to decryption</a>
    
    <div class="btn-group" role="group">                                                                                                                                                                                                                                                                                                                                                                                           
        <input type="radio" class="btn-check" name="IsFileMode" id="textMode" value="false" checked>                                                                                                                                                                                                                                                                                                                  
        <label class="btn btn-outline-primary" for="textMode">Text</label>
                                                                                                                                                                                                                                                                                                                                                                                                                                 
        <input type="radio" class="btn-check" name="IsFileMode" id="fileMode" value="true" >                                                                                                                                                                                                                                                                                                                         
        <label class="btn btn-outline-primary" for="fileMode">File</label>
    </div>
    
    <form asp-action="Encryption" enctype="multipart/form-data">
        <div class="row" id="textField">
            <label asp-for="@Model.InputText" class="form-label">plaintext</label>
            <textarea type="text" asp-for="@Model.InputText" class="form-control"></textarea>
        </div>
        <div class="row" id="fileField" style="display:none">
            <label asp-for="@Model.InputFile" class="form-label">plainfile</label>
            <input type="file" asp-for="@Model.InputFile" class="form-control"></input>
        </div>
        <div class="row">
            <div class="col">
                <label asp-for="@Model.Key" class="form-label">key</label>
                <input asp-for="@Model.Key" class="form-control" type="text" value="@Model.Key"/>
            </div>
            <div class="col">
                <label asp-for="@Model.IV" class="form-label">IV</label>
                <input asp-for="@Model.IV" class="form-control" type="text" value="@Model.IV"/>
            </div>
        </div>
        <div class="row">
            <div class="col">
                <label asp-for="@Model.CipherMode" class="form-label">cipher mode</label>
                <select asp-for="@Model.CipherMode" class="form-select">
                    <option>CBC</option>
                    <option>ECB</option>
                    <option disabled>GCM</option>
                </select>
            </div>
            <div class="col">
                <label asp-for="@Model.PaddingMode" class="form-label">padding mode</label>
                <select asp-for="@Model.PaddingMode" class="form-select">
                    <option>PKCS7</option>
                    <option>Zeros</option>
                    <option>None</option>
                </select>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Apply Encryption</button>
    </form>
    <code>@Model.OutputText</code>
</div>

<script>
      document.querySelectorAll('input[name="IsFileMode"]').forEach(radio => {
          radio.addEventListener('change', () => {
              const isFile = radio.value === 'true';
              document.getElementById('textField').style.display = isFile ? 'none' : '';
              document.getElementById('fileField').style.display = isFile ? '' : 'none';
          });
      });
</script>
