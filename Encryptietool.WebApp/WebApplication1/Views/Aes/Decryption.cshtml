@model AesDecryptionViewModel
<div>
    <a asp-action="Encryption">Go to encryption</a>
    
<form asp-action="Decryption" enctype="multipart/form-data">
        
    <div class="form-check">
        <input type="checkbox" asp-for="IsFileUpload" class="form-check-input">                                                                                                                                                                                                                                                                                                                                                        
        <label asp-for="IsFileUpload" class="form-check-label">File?</label> 
    </div>
    
        <div class="row mx-0 text-field">
            <label asp-for="@Model.InputText" class="form-label">input text</label>
            <textarea type="text" asp-for="@Model.InputText" class="form-control"></textarea>
        </div>
        
        <div class="row mx-0 file-field">
            <label asp-for="@Model.InputFile" class="form-label">input file</label>
            <input type="file" asp-for="@Model.InputFile" class="form-control"></input>
        </div>
        
        <div class="row">
            <div class="col">
                <label asp-for="@Model.Key" class="form-label">key</label>
                <input asp-for="@Model.Key" class="form-control" type="text" value="@Model.Key"/>
            </div>
            <div class="col">
                <label asp-for="@Model.IV" class="form-label">IV</label>
                <input asp-for="@Model.IV" class="form-control" type="text" value="@Model.IV"/>
            </div>
        </div>
        <div class="row">
            <div class="col">
                <label asp-for="@Model.CipherMode" class="form-label">cipher mode</label>
                <select asp-for="@Model.CipherMode" class="form-select">
                    <option>CBC</option>
                    <option>ECB</option>
                    <option disabled>GCM</option>
                </select>
            </div>
            <div class="col">
                <label asp-for="@Model.PaddingMode" class="form-label">padding mode</label>
                <select asp-for="@Model.PaddingMode" class="form-select">
                    <option>PKCS7</option>
                    <option>Zeros</option>
                    <option>None</option>
                </select>
            </div>
        </div>
        <button type="submit" class="btn btn-primary my-3">Apply Decryption</button>
    </form>
    
    <div class="row mx-0 text-field">
        <label asp-for="@Model.OutputText" class="form-label">input text</label>
        <textarea type="text" asp-for="@Model.OutputText" class="form-control" disabled></textarea>
    </div>
    <div class="row mx-0 file-field">
        <label asp-for="@Model.OutputFile" class="form-label">output file</label>
        <a asp-action="Download" asp-route-filename="@Model.OutputFile" class="btn btn-success">Download</a>
    </div>
</div>